{
  "name": "jobpilot",
  "private": true,
  "packageManager": "bun@1.3.4",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "bun --filter @jobpilot/api dev",
    "dev:worker": "bun --filter @jobpilot/worker dev",
    "dev:dashboard": "bun --filter @jobpilot/dashboard dev",
    "lint": "turbo run lint",
    "db:migrate": "bun --filter @jobpilot/db db:migrate",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  }
}
