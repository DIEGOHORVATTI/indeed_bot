# AI Provider
ANTHROPIC_API_KEY=sk-ant-...
AI_PROVIDER=api
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SMART=claude-opus-4-20250514

# Optional: path to claude binary (for CLI provider)
# CLAUDE_CLI_PATH=/usr/local/bin/claude

# Redis
REDIS_URL=redis://localhost:6379

# Paths
DATA_DIR=./data
DB_PATH=./data/jobs.db
PDF_DIR=./data/pdfs

# Proxy (opcional - para bypass de bloqueio Cloudflare)
# PROXY_URL=socks5://user:pass@host:port

# Server
PORT=8004
DASHBOARD_PORT=8005
