# AI provider: "cli" (Claude CLI, default) or "api" (Anthropic SDK)
AI_PROVIDER=cli

# Only needed when AI_PROVIDER=api
ANTHROPIC_API_KEY=sk-ant-...

# Optional: path to claude binary (auto-detected if omitted)
# CLAUDE_CLI_PATH=/usr/local/bin/claude

# Model overrides (work with both providers)
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
# ANTHROPIC_MODEL_SMART=claude-opus-4-20250514
