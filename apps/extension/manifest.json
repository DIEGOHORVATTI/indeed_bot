{
  "manifest_version": 3,
  "name": "JobPilot",
  "version": "0.4.1",
  "description": "Auto-apply to jobs across all platforms with AI-tailored CV and smart form filling",
  "permissions": [
    "tabs",
    "storage",
    "notifications",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.indeed.com/*"
      ],
      "exclude_matches": [
        "*://smartapply.indeed.com/*"
      ],
      "js": [
        "content/indeed.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://smartapply.indeed.com/*"
      ],
      "js": [
        "content/mainworld.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://smartapply.indeed.com/*"
      ],
      "js": [
        "content/smartapply.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["*://*.linkedin.com/*"],
      "exclude_matches": ["*://*.linkedin.com/messaging/*"],
      "js": ["content/linkedin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://*.indeed.com/*",
        "*://smartapply.indeed.com/*",
        "*://*.linkedin.com/*",
        "*://chrome.google.com/*"
      ],
      "js": ["content/generic-form.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
